NOMINATIM_USER_AGENT=DisasterCommandCenter/1.0 (github.com/sarthakchoubey667-max/Disaster-command-center)
GEOCODING_CACHE_SECONDS=86400
GEOCODING_LANGUAGE=en
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
