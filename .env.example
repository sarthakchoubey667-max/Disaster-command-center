ALERT_DELIVERY_ENABLED=false
ALERT_RISK_THRESHOLD=60
ALERT_MONITOR_INTERVAL_SECONDS=900
ALERT_COOLDOWN_SECONDS=3600
ALERT_RECIPIENTS=
